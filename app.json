{
  "expo": {
    "name": "AdePulsa",
    "slug": "AppPulsa",
    "scheme": "apppulsa",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "bundleIdentifier": "com.maflogictech.AppPulsa",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8B0D1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.maf_logictech.AppPulsa",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#2B0B11"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a9b8973-a3cc-4117-8879-3bdd414bcb3f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/0a9b8973-a3cc-4117-8879-3bdd414bcb3f"
    }
  }
}
